# Whisper-Service Backend
WHISPER_URL=https://whisper.bay-ram.de
WHISPER_BEARER=<dein-app-token-aus-der-Web-UI>

# Auth — exakt wie hero-mcp
MCP_API_KEY=<random-32-bytes-hex-für-Claude-Desktop>
OIDC_INTROSPECTION_URL=https://authelia.bay-ram.de/api/oidc/introspection
OIDC_CLIENT_ID=whisper-mcp
OIDC_CLIENT_SECRET=<random-secret>

# Optional
LOG_LEVEL=INFO
MCP_TRANSPORT=sse
PORT=8000
